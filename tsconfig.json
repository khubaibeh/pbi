{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"$pbi/*": ["./src/pbi/*"],
			"$formatter/*": ["./src/formatter/*"],
			"$tmdl/*": ["./src/tmdl/*"]
		},
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src", "tests"]
}
