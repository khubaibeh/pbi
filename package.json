{
	"name": "pbi",
	"version": "0.1.0",
	"description": "[EXPERIMENTAL] Tool(s) for interacting with power bi reports.",
	"license": "MIT",
	"bin": {
		"pbi": "./src/pbi/cli/main.ts"
	},
	"type": "module",
	"imports": {
		"#pbi/*.ts": "./src/pbi/*.ts",
		"#pbi/*": "./src/pbi/*/index.ts"
	},
	"scripts": {
		"prepare": "vp config",
		"build": "vp pack",
		"pbi": "node src/pbi/cli/main.ts",
		"check": "vp check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@effect/platform-node": "4.0.0",
		"effect": "4.0.0",
		"jsonc-parser": "3.3.1"
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"ajv": "8.20.0",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.4.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	}
}
